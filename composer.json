{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hackathon-fiap-soat/fiapx-video-api",
    "type": "project",
    "description": "FIAP X: API de vídeos e orquestrador da SAGA de processamento (Laravel 13, DDD + Clean Architecture)",
    "keywords": [
        "fiapx",
        "laravel",
        "saga",
        "sqs"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.403",
        "firebase/php-jwt": "^7.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "ramsey/uuid": "^4.10"
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^12.5.12",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "phpunit --no-coverage"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "pint --test",
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test:coverage": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit",
            "@php scripts/coverage-check.php coverage/clover.xml 80"
        ],
        "bdd": [
            "behat --no-interaction --format=progress"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
