# Gerado pelo deploy.yml a partir do SSM /fiapx/prod/... Não editar à mão; aws.env fica fora do git.
# A chave pública do JWT (PEM de várias linhas) não entra aqui: o app a lê do SSM (auth/jwt_public_key).
FIAPX_ENV=prod
AWS_REGION=us-east-1
S3_VIDEOS_BUCKET=fiapx-prod-videos
SQS_VIDEO_UPLOADED_URL=https://sqs.us-east-1.amazonaws.com/000000000000/fiapx-prod-video-uploaded
SQS_SAGA_REPLIES_URL=https://sqs.us-east-1.amazonaws.com/000000000000/fiapx-prod-saga-replies.fifo
SQS_PROCESSING_COMMANDS_URL=https://sqs.us-east-1.amazonaws.com/000000000000/fiapx-prod-processing-commands
SQS_NOTIFICATION_COMMANDS_URL=https://sqs.us-east-1.amazonaws.com/000000000000/fiapx-prod-notification-commands
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-1:000000000000:targetgroup/fiapx-prod-video-api/0000000000000000
NEW_RELIC_ENABLED=false
