# Ambiente local (docker compose deste repositório, na rede do fiapx-infra/local).
# Valores fictícios de uso local. Na AWS, as variáveis vêm do ConfigMap e do Secret do Kubernetes.

APP_NAME=fiapx-video-api
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_CHANNEL=json
LOG_LEVEL=info

# MySQL do fiapx-infra/local (usuário só com acesso ao fiapx_video)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fiapx_video
DB_USERNAME=fiapx_video
DB_PASSWORD=fiapx_video_local

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# AWS: LocalStack. Os nomes de bucket e filas e a chave pública do JWT vêm do SSM /fiapx/local/...
FIAPX_ENV=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
# Endpoint das URLs pré-assinadas que o navegador usa (fora do Docker)
AWS_S3_PUBLIC_ENDPOINT=http://localhost:4566

# Opcionais (sem elas, valem o SSM e os padrões da documentação)
# S3_VIDEOS_BUCKET=
# SQS_VIDEO_UPLOADED_URL=
# SQS_SAGA_REPLIES_URL=
# SQS_PROCESSING_COMMANDS_URL=
# SQS_NOTIFICATION_COMMANDS_URL=
# JWT_PUBLIC_KEY=
# FIAPX_PROCESSING_TIMEOUT_SECONDS=1800
# FIAPX_NOTIFY_ON_COMPLETED=true
# FIAPX_MAX_PARALLEL_PER_USER=5
